# --- AI (required for roadmap generation & the assistant) ---
# Default provider: Google Gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
# AI_MODEL=gemini-2.5-flash

# Or use any OpenAI-compatible API instead (OpenCode Zen, OpenRouter, Ollama, ...):
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://openrouter.ai/api/v1     # e.g. http://localhost:11434/v1 for Ollama
# AI_API_KEY=
# AI_MODEL=

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:9002

# --- Database (local Docker MongoDB from `npm run db:up`) ---
MONGO_ROOT_USERNAME=pathwise
MONGO_ROOT_PASSWORD=pathwise_dev_password
MONGO_DB_NAME=pathwise
MONGO_PORT=27017
MONGODB_URI=mongodb://pathwise:pathwise_dev_password@localhost:27017/pathwise?authSource=admin
