{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 9002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "format": "prettier --write . && git add .",
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongo",
    "db:setup": "node scripts/db-setup.mjs",
    "db:seed": "node scripts/db-setup.mjs --seed",
    "db:compass": "node scripts/open-compass.mjs",
    "docker:app": "docker compose --profile app up -d --build"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.112",
    "@ai-sdk/openai-compatible": "^3.0.85",
    "ai": "^7.0.163",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.69.0",
    "mongodb": "^7.8.0",
    "motion": "^14.9.1",
    "next": "^16.4.5",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "husky": "^9.1.7",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
